{
  "name": "@octoverse-id/octoreview",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for Octoreview: multi-tenant reviews, ratings and review media.",
  "keywords": [
    "octoreview",
    "reviews",
    "ratings",
    "sdk",
    "api-client"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/octoverse-id/octoreview-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octoverse-id/octoreview-js.git"
  },
  "bugs": {
    "url": "https://github.com/octoverse-id/octoreview-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project unit",
    "contract": "vitest run --project contract",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
